# Neurovia Backend Configuration

# MongoDB Connection
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/neurovia_db
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/neurovia_db?retryWrites=true&w=majority

# JWT Authentication
# Use a long random string. Do not reuse this placeholder.
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1d

# Server Configuration
PORT=5000
NODE_ENV=development
# Used to build absolute links in emails (e.g. password reset)
SERVER_BASE_URL=http://localhost:5173

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Rate Limiting (general REST traffic)
# NOTE: must be a plain integer in milliseconds, not an expression.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Rate Limiting (notification polling)
POLLING_RATE_LIMIT_WINDOW_MS=60000
POLLING_RATE_LIMIT_MAX=240

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5mb
MAX_VIDEO_SIZE=500mb

# Email (optional — only required for password-reset / transactional email)
# EMAIL_SERVICE=gmail
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=Neurovia <no-reply@neurovia.app>
